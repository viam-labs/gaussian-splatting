# Copy to .env (gitignored). Create an API key on app.viam.com.
# splat-scan: a key with access to the machine. splat-build and the module's upload: an organization key.
VIAM_API_KEY_ID=
VIAM_API_KEY=
VIAM_MACHINE_ADDRESS=<part>.viam.cloud
# Part the uploads are attributed to (viam-server sets VIAM_MACHINE_PART_ID for modules; set it here for local runs).
VIAM_MACHINE_PART_ID=
